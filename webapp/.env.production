# Firebase web config for production builds. Committed on purpose: Cloudflare
# Workers Builds builds from this repo, and without these values every build
# ships an empty config and boards hang on "Loading board…". They're not
# secrets, since each one ships to every participant's browser; Firestore's
# security rules control access (see ../firestore.rules). Never put the
# service-account key or any other credential in this file.
VITE_FIREBASE_API_KEY=AIzaSyAu-aDmfwt7jmLFvs66ciCKi9d3mHPtgqk
VITE_FIREBASE_AUTH_DOMAIN=mvote-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mvote-app
VITE_FIREBASE_STORAGE_BUCKET=mvote-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=588674575231
VITE_FIREBASE_APP_ID=1:588674575231:web:327f7a9e21954bcc1ac84a

VITE_USE_MOCK=false
