{
  "name": "mvote-webapp",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:environment": "node ../scripts/check-environment.mjs",
    "check:ui": "malverdesoftware-ui-check .",
    "verify": "npm run check:environment && npm run check:ui && npm test -- --maxWorkers=2 --minWorkers=1 && npm run build && node ../scripts/build-manifest.mjs",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "build:demo": "vite build --mode demo --outDir dist-demo"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "5.3.0",
    "@jetbrains/icons": "5.24.0",
    "@jetbrains/ring-ui-built": "7.0.133",
    "@malverdesoftware/ui": "0.1.1",
    "firebase": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^25.0.0",
    "vite": "^5.4.0",
    "vitest": "^5.1.0"
  }
}
