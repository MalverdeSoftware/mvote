rules_version = '2';

// Security rules for the mVote webapp's no-account, anonymous
// voting flow. Deploy with: firebase deploy --only firestore:rules
//
// Casting a vote writes two documents in one transaction: the participant
// spends a dot (participants/{id}) and the item's count goes up by one
// (votes/{itemId}). Each document's rule uses getAfter() to check that the
// other document changes to match in the same write, so a vote can't be
// added without spending a dot, and a dot can't be spent without adding the
// vote. The participant records which item it voted for (last_item) and the
// vote records who voted (last_voter) so each side can find the other.
//
// A board with closed: true (set by `mvote close`) takes no new
// participants, votes or extra dots. Reading stays open, so the final counts
// still show.
//
// Remaining limitation: participants have no accounts, so someone who clears
// their browser storage or uses another device starts with fresh dots. mVote
// is meant for sessions with a facilitator in the room.
service cloud.firestore {
  match /databases/{database}/documents {

    match /boards/{boardId} {
      // Boards are written only by the facilitator's CLI via the Firebase
      // Admin SDK, which bypasses these rules entirely. Clients only read,
      // and only a board whose id they already have: listing is off, so
      // nobody can enumerate every board.
      allow get: if true;
      allow list: if false;
      allow write: if false;

      function boardOpen() {
        return get(/databases/$(database)/documents/boards/$(boardId)).data.get('closed', false) == false;
      }

      match /votes/{itemId} {
        // Vote docs are pre-created (count: 0) by the CLI when a board is
        // published. Clients may only increment an existing item's count
        // by exactly 1 per write — never create a new item, delete one,
        // or set an arbitrary value.
        allow read: if true;
        allow create, delete: if false;
        allow update: if boardOpen()
                       && request.resource.data.count == resource.data.count + 1
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['count', 'placements', 'last_voter'])
                       && request.resource.data.last_voter is string
                       && spentDotOn(request.resource.data.last_voter, itemId);

        // The named participant spends exactly one dot on this item in the same write.
        function spentDotOn(participantId, itemId) {
          let path = /databases/$(database)/documents/boards/$(boardId)/participants/$(participantId);
          let before = get(path).data;
          let after = getAfter(path).data;
          return after.remaining_dots == before.remaining_dots - 1
                 && after.get('last_item', null) == itemId
                 && after.votes.get(itemId, 0) == before.votes.get(itemId, 0) + 1;
        }
      }

      match /participants/{participantId} {
        // Anonymous, no-account participants. The random participant id
        // kept in the browser is the only thing that identifies a record,
        // so a record can be fetched by id (a participant re-fetches their
        // own remaining dots after a page reload) but records can't be
        // listed: listing would hand out every participant's id, and with
        // it the ability to spend their dots. A participant may create
        // their own starting record and can only update it via the two
        // legitimate transitions — spending one dot, or re-upping by 4
        // once empty.
        allow get: if true;
        allow list: if false;
        allow create: if boardOpen()
                       && request.resource.data.remaining_dots == 8
                       && request.resource.data.votes == {}
                       && request.resource.data.keys().hasOnly(['remaining_dots', 'votes']);
        allow update: if boardOpen() && (isDotSpend() || isReup());
        allow delete: if false;

        // One dot goes to one item, and that item's count goes up by one in
        // the same write, recorded as this participant's vote.
        function isDotSpend() {
          let item = request.resource.data.last_item;
          let votePath = /databases/$(database)/documents/boards/$(boardId)/votes/$(item);
          return item is string
                 && resource.data.remaining_dots > 0
                 && request.resource.data.remaining_dots == resource.data.remaining_dots - 1
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['remaining_dots', 'votes', 'last_item'])
                 && request.resource.data.votes.diff(resource.data.votes).affectedKeys().hasOnly([item])
                 && request.resource.data.votes[item] == resource.data.votes.get(item, 0) + 1
                 && getAfter(votePath).data.count == get(votePath).data.count + 1
                 && getAfter(votePath).data.get('last_voter', null) == participantId;
        }

        function isReup() {
          return resource.data.remaining_dots == 0
                 && request.resource.data.remaining_dots == 4
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['remaining_dots']);
        }
      }
    }
  }
}
